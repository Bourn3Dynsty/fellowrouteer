<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS8600;CS8602;CS8604;CS1591</NoWarn>
    <CUE4ParseDir Condition="'$(CUE4ParseDir)' == ''">$(MSBuildThisFileDirectory)../.work/CUE4Parse</CUE4ParseDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse/CUE4Parse.csproj" />
  </ItemGroup>
</Project>
